# =============================================================
# BioGuard_WearOs - Firma de la app release (PLANTILLA)
# =============================================================
# Copia este archivo a `keystore.properties` (LOCAL) y completa con
# los datos de TU keystore. NUNCA subas keystore.properties a git.
#
# En CI (GitHub Actions) no se usa este archivo: se inyectan las
# variables de entorno (GitHub Secrets):
#   BIOGUARD_WEAR_STORE_FILE      (contenido base64 del .jks)
#   BIOGUARD_WEAR_STORE_PASSWORD
#   BIOGUARD_WEAR_KEY_ALIAS
#   BIOGUARD_WEAR_KEY_PASSWORD
#
# Referencia: app/build.gradle.kts (signingConfigs -> release)
# =============================================================

storeFile=tu_keystore_release.jks
storePassword=tu_password_del_keystore
keyAlias=tu_alias_de_la_key
keyPassword=tu_password_de_la_key
