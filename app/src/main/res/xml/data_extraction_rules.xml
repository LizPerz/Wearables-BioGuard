<?xml version="1.0" encoding="utf-8"?>
<!--
  DevSecOps hardening: los datos de BioGuard (tokens JWT, lecturas biométricas,
  identificadores de paciente/dispositivo) NUNCA deben exportarse vía
  backup en la nube ni transferencia entre dispositivos.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
